# Python
__pycache__/
*.py[oc]
*.pyo
build/
dist/
wheels/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# uv
.python-version

# Jupyter
.ipynb_checkpoints/
*.ipynb~

# DVC-managed directories (tracked via dvc.yaml / .dvc files, not git)
/data/
/results/*

# Exception: the DAG patching artifacts are not a DVC stage and never were --
# they appear in neither dvc.yaml nor dvc.lock. They are half a megabyte of JSON
# and the only record of the pilot's per-item measurements, so they go in git
# directly. There is no DVC remote on this host, which would make .dvc/cache the
# only copy and a checkout/gc irreversible; git is the safer home for something
# this small. Only .json and the README are admitted, one path at a time, so a
# stray large output dropped in this directory cannot ride along.
!/results/dag_patching/
/results/dag_patching/*
!/results/dag_patching/*.json
!/results/dag_patching/README.md

# Same exception, one level down: the paired depth-ladder rerun. Kept apart
# from the archived, immutable package above rather than merged into it.
!/results/dag_patching/paired_ladder/
/results/dag_patching/paired_ladder/*
!/results/dag_patching/paired_ladder/*.json
!/results/dag_patching/paired_ladder/README.md

# And the cross-item donor control, likewise its own arm.
!/results/dag_patching/cross_item/
/results/dag_patching/cross_item/*
!/results/dag_patching/cross_item/*.json
!/results/dag_patching/cross_item/README.md

# DVC internals (keep .dvc/config and .dvc/.gitignore, but not cache)
.dvc/cache/
.dvc/tmp/

# Logs and metrics
logs/
metrics.json
state

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# omx runtime state
.omx/

# codex
.codex
docs/superpowers

# Local safety copy of results/ before a rerun (not a deliverable)
/.results_backup_*/
